# Public origin used for verification links and OAuth callbacks
REPAIRLY_PUBLIC_URL=http://127.0.0.1:3000

# Resend email API. Use a sender address verified in your Resend account.
RESEND_API_KEY=
REPAIRLY_FROM_EMAIL="Repairly <noreply@example.com>"

# OAuth credentials (create one OAuth app per provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
